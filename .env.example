# =============================================================================
# CivicLens Environment Configuration (Template)
# =============================================================================
# Copy this file to .env and customize for your local development environment.
# DO NOT commit real secrets or production credentials to version control.

# Application Environment: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# Secret Key for session signing and CSRF protection (generate with `openssl rand -hex 32`)
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key

# Database Configuration
# Local SQLite default path (relative to project root or absolute)
DATABASE_PATH=backend/pothole_reports.db
# Future PostgreSQL connection string (optional in Step 2):
# DATABASE_URL=postgresql://civiclens_user:civiclens_password@localhost:5432/civiclens_db

# Deduplication Settings
# Maximum radius in meters for considering reports as potentially describing the same physical issue
DEDUP_RADIUS_METERS=15.0

# Geolocation & Reverse Geocoding
# OpenStreetMap Nominatim compliance: User-Agent is mandatory per OSM usage policy
NOMINATIM_USER_AGENT=CivicLens-Infrastructure/1.0 (civic-triage-demo)
# Minimum interval in seconds between external Nominatim API calls (respect 1 req/sec policy)
NOMINATIM_RATE_LIMIT_SECONDS=1.0

# CORS Configuration
# Comma-separated list of allowed origins, or '*' for development/demo
CORS_ORIGINS=*

# Logging
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# File Uploads (Evidence Assets)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16
