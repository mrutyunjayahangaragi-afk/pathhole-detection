# =============================================================================
# CivicLens — Environment Configuration (Template)
# =============================================================================
# Copy this file to `.env` and customize for your local development environment.
# NEVER commit real credentials, secrets, or production passwords to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & DEBUGGING
# -----------------------------------------------------------------------------
# Active environment: development | testing | production
# Note: In Flask 3.x, APP_ENV or FLASK_ENV specifies the environment tier.
APP_ENV=development
FLASK_ENV=development

# Debug Mode: 1 (enabled for local dev) or 0 (disabled).
# CRITICAL: Debug mode is automatically rejected with an error in production.
FLASK_DEBUG=1

# Server Network Binding:
# Use 127.0.0.1 for local isolation, or 0.0.0.0 to bind all network interfaces.
HOST=127.0.0.1

# Server Port:
# Port 5055 is recommended on macOS (port 5000 is occupied by AirPlay Receiver).
PORT=5055

# Cryptographic Secret Key for signed session cookies, tokens, and CSRF protection.
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
# In production, this MUST be explicitly set to a unique, random >=32-char secret.
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION & SUPABASE POSTGRESQL
# -----------------------------------------------------------------------------
# Database Provider: 'sqlite' (local default) or 'supabase' / 'postgresql'
DATABASE_PROVIDER=sqlite

# Local SQLite Database Path (used when DATABASE_PROVIDER=sqlite)
# Relative to project root or absolute path.
DATABASE_PATH=backend/pothole_reports.db

# Supabase PostgreSQL Connection String (REQUIRED when DATABASE_PROVIDER=supabase)
# Where to find in Supabase Dashboard:
#   Project Settings -> Database -> Connection String -> URI
# Modes:
#   - Transaction Pooler (Port 6543): Best for serverless, short-lived connections
#   - Session Pooler / Direct (Port 5432): Supports persistent connections & migrations
# Syntax:
#   postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:Muttu@6362%@db.aguycrrswebcvnouxqrr.supabase.co:5432/postgres
# Optional Supabase Project Metadata (for client SDK integrations if used)
SUPABASE_URL=https://aguycrrswebcvnouxqrr.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFndXljcnJzd2ViY3Zub3V4cXJyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ3NjM3MTMsImV4cCI6MjExMDMzOTcxM30.9V4TMc-CAU2SccazF78Daj_rZZenydq_qRZCpyh8VHw

# -----------------------------------------------------------------------------
# 3. CIVIC TRIAGE & DEDUPLICATION SETTINGS
# -----------------------------------------------------------------------------
# Maximum radius in meters for considering defect reports as candidates for
# the same physical road hazard (15.0 meters default). Note: distinct potholes
# close together remain separate incidents pending human/engineering triage.
DEDUP_RADIUS_METERS=15.0

# -----------------------------------------------------------------------------
# 4. GEOLOCATION & REVERSE GEOCODING (NOMINATIM)
# -----------------------------------------------------------------------------
# OpenStreetMap Nominatim compliance: User-Agent is mandatory per OSM usage policy.
NOMINATIM_USER_AGENT=CivicLens-Infrastructure/1.0 (civic-triage-demo)

# Minimum interval in seconds between external Nominatim API calls (respect 1 req/sec policy).
NOMINATIM_RATE_LIMIT_SECONDS=1.0

# -----------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. For local development, specify explicit
# origins rather than wildcards when handling authenticated sessions.
CORS_ORIGINS=http://localhost:5055,http://127.0.0.1:5055

# -----------------------------------------------------------------------------
# 6. LOGGING & DIAGNOSTICS
# -----------------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 7. EVIDENCE FILE UPLOADS
# -----------------------------------------------------------------------------
# Local storage directory for citizen photographic and video evidence.
UPLOAD_FOLDER=uploads

# Maximum allowable request content length in megabytes (16 MB default).
MAX_CONTENT_LENGTH_MB=16

# -----------------------------------------------------------------------------
# 8. AI DEFECT DETECTION PIPELINE (YOLOv8)
# -----------------------------------------------------------------------------
# Defect detection model name and version
MODEL_NAME=yolov8-pothole
MODEL_VERSION=v1.0.0

# Path to trained YOLO weights (.pt). If not configured or missing, the system
# safely flags inference status as MODEL_WEIGHTS_MISSING without crashing or fabricating fake results.
MODEL_WEIGHTS_PATH=weights/pothole_yolov8.pt

# Minimum confidence threshold (0.0 to 1.0) to register a candidate detection
CONFIDENCE_THRESHOLD=0.40

# High confidence threshold for strong suggestions vs review flag
HIGH_CONFIDENCE_THRESHOLD=0.75

# Non-Maximum Suppression (NMS) Intersection over Union (IoU) threshold
IOU_THRESHOLD=0.45

# Whether to automatically queue defect detection upon citizen report submission
AUTO_DETECT_ON_SUBMISSION=1

# -----------------------------------------------------------------------------
# 9. MAP TILES & CARTO CONFIGURATION
# -----------------------------------------------------------------------------
# Optional CARTO Maps API key if using a private CARTO account or key-restricted tiles.
# Leave blank to use public OpenStreetMap / CARTO basemaps (or automatic OSM fallback).
CARTO_API_KEY=

# -----------------------------------------------------------------------------
# 10. INTELLIGENT DUPLICATE INCIDENT MATCHING ENGINE
# -----------------------------------------------------------------------------
DUPLICATE_MATCHING_ENABLED=true
DUPLICATE_AUTO_LINK_ENABLED=false
DUPLICATE_REQUIRE_HUMAN_REVIEW=true

# -----------------------------------------------------------------------------
# 11. PUBLIC MAP & VIEWPORT QUERY SETTINGS
# -----------------------------------------------------------------------------
# Default search radius in kilometers for public boundary queries
PUBLIC_MAP_DEFAULT_RADIUS_KM=25.0
# Maximum canonical incidents returned in a single viewport query
PUBLIC_MAP_MAX_VIEWPORT_POINTS=500

# -----------------------------------------------------------------------------
# 12. CENTRALIZED NOTIFICATION INFRASTRUCTURE
# -----------------------------------------------------------------------------
# Email provider: 'console' (local logs), 'smtp', or 'disabled'
NOTIFICATION_PROVIDER_EMAIL=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@civiclens.org

# SMS provider: 'console', 'twilio', or 'disabled'
NOTIFICATION_PROVIDER_SMS=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp provider: 'disabled' or 'meta_business'
NOTIFICATION_PROVIDER_WHATSAPP=disabled
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# Browser Web Push: 'disabled' or 'webpush'
NOTIFICATION_PROVIDER_PUSH=disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@civiclens.org
